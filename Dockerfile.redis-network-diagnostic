# Isolated feasibility test: can the pinned Fleetbase image contain a local Redis binary?
# This Dockerfile is ONLY deployed to fleetbase-v075-redis-netdiag, never API.
FROM redis:7.4-bookworm AS redis-bin
FROM ghcr.io/shabdinus-micllp/fleetbase-api-clean@sha256:53b950f61b4872f31a16bbd5b8c0519a234cd959fd4f0ada448c13c0df25564a
COPY --from=redis-bin /usr/local/bin/redis-server /tmp/redis-server
EXPOSE 10000
CMD ["sh", "-c", "echo '[local-redis-test] checking redis binary'; /tmp/redis-server --version || true; echo '[local-redis-test] starting isolated HTTP'; exec php -S 0.0.0.0:10000 -t /fleetbase/api/public"]
